{
  "name": "@wm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:seed:demo": "tsx --env-file=.env prisma/seed-demo.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "10.3.0",
    "@prisma/client": "^6.2.1",
    "@wm/shared": "*",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.15.2",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "swissqrbill": "^4.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
