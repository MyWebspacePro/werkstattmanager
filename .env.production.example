# Produktion (VPS) — VORLAGE: kopieren als .env und Werte ersetzen!
# cp .env.production.example .env && nano .env

# Domain (NACH dem DNS-Umzug eintragen; aktiviert automatisches HTTPS)
APP_DOMAIN=

# Datenbank — STARKE Passwörter verwenden!
POSTGRES_USER=werkstatt
POSTGRES_PASSWORD=HIER-STARKES-PASSWORT
POSTGRES_DB=werkstatt

# JWT — erzeugen mit: openssl rand -hex 32
JWT_SECRET=HIER-ZUFALLSWERT-32-BYTES
JWT_REFRESH_SECRET=HIER-ANDERER-ZUFALLSWERT-32-BYTES

# E-Mail-Versand (IONOS SMTP der Werkstatt-Domain)
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=rechnung@deine-domain.ch
SMTP_PASSWORD=HIER-MAIL-PASSWORT
SMTP_FROM=Werkstatt <rechnung@deine-domain.ch>
